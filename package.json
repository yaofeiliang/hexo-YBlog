{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "hexo generate && pagefind --site public",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "build:preview": "hexo clean && hexo generate --config _config.yml,_config.preview.yml && pagefind --site public",
    "validate:content": "node automation/scripts/validate-content.mjs",
    "validate:links": "node automation/scripts/validate-internal-links.mjs",
    "news:dry-run": "node automation/scripts/ingest-news.mjs",
    "news:ingest": "node automation/scripts/ingest-news.mjs --write",
    "news:history:dry-run": "node automation/scripts/generate-historical-news.mjs",
    "news:history:write": "node automation/scripts/generate-historical-news.mjs --write",
    "admin:dev": "wrangler dev --config admin/wrangler.toml",
    "admin:deploy": "node admin/scripts/predeploy-check.mjs && wrangler deploy --config admin/wrangler.toml",
    "admin:db:local": "wrangler d1 execute yblog-admin --local --file admin/schema.sql --config admin/wrangler.toml",
    "admin:typecheck": "tsc --noEmit -p admin/tsconfig.json"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "hexo": "^8.1.2",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hono": "^4.12.32",
    "pagefind": "^1.5.2",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "hexo-admin": "^2.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.114.0"
  }
}
