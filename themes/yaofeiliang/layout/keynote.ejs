---
layout: layout
---
<article>
    <div class="container">
        <div class="row">
            <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1 post-container">
                <%- page.content %>
                <hr>
                <ul class="pager">
                    <% if (page.prev){ %>
                        <li class="previous">
                            <a href="<%- config.root %><%- page.prev.path %>" title="<%- page.prev.title %>">← Previous Post</a>
                        </li>
                    <% } %>
                    <% if (page.next){ %>
                        <li class="next">
                            <a href="<%- config.root %><%- page.next.path %>" title="<%- page.next.title %>">Next Post →</a>
                        </li>
                    <% } %>
                </ul>
                <%- partial('_partial/comments') %>
            </div>
            <%- partial('_partial/toc') %>
        </div>
    </div>
</article>
