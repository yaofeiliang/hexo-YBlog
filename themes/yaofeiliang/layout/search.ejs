---
layout: layout
---
<div class="container search-page">
    <div class="row">
        <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1">
            <div class="search-page__intro">
                <h1 data-i18n="search.title">搜索文章</h1>
                <p data-i18n="search.intro">检索原创文章与每日技术简报。支持中英文关键词。</p>
            </div>
            <div id="search"></div>
        </div>
    </div>
</div>
<link rel="stylesheet" href="<%= config.root %>pagefind/pagefind-ui.css">
<script type="module">
  import { PagefindUI } from "<%= config.root %>pagefind/pagefind-ui.js";
  const mountSearch = () => {
    const target = document.querySelector("#search");
    const t = (key) => window.YBlogI18n ? window.YBlogI18n.t(key) : key;
    target.replaceChildren();
    new PagefindUI({
      element: "#search",
      showSubResults: true,
      showImages: false,
      translations: {
        placeholder: t('search.placeholder'),
        clear_search: t('search.clear'),
        load_more: t('search.loadMore'),
        search_label: t('search.label'),
        filters_label: t('search.filters'),
        zero_results: t('search.empty'),
        many_results: t('search.many'),
        one_result: t('search.one')
      }
    });
  };
  mountSearch();
  document.addEventListener('yblog:localechange', mountSearch);
</script>
