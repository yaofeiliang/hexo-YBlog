<%
  const pageTitle = page.title ? (page.title + ' - ' + config.SEOTitle) : config.SEOTitle;
  const pageDesc = page.description || page.subtitle || (is_post() ? truncate(strip_html(page.content), { length: 160, omission: '…' }) : config.description) || '';
  const rawHero = is_home()
    ? config['header-img']
    : (is_post()
      ? (page['header-img'] || config['article-img'])
      : (page['header-img'] || config['archives-img'] || config['header-img']));
  const heroPath = '/' + (rawHero || '').replace(/^\//, '');
  const heroAbs = full_url_for(heroPath);
  const heroWebp = heroAbs.replace(/\.(jpg|jpeg|png)$/i, '.webp');
  const canonical = full_url_for((page.path || '').replace(/index\.html$/, '') || '/');
  const ogType = is_post() ? 'article' : 'website';
%>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <script>
      (function () {
        try {
          var query = new URLSearchParams(location.search).get('lang');
          var saved = query || localStorage.getItem('yblog.locale');
          var locale = saved || ((navigator.languages || [navigator.language || '']).some(function (item) { return /^zh/i.test(item); }) ? 'zh-CN' : 'en');
          document.documentElement.lang = /^zh/i.test(locale) ? 'zh-CN' : 'en';
          document.documentElement.dataset.locale = document.documentElement.lang;
        } catch (_) {}
      })();
    </script>
    <meta name="description" content="<%= pageDesc %>">
    <meta name="keywords" content="<%= config.keyword || config.keywords || '' %>">
    <meta name="author" content="<%= config.author %>">
    <meta name="theme-color" content="#0085a1">
    <link rel="shortcut icon" href="<%= config.root %>img/y.png">
    <link rel="alternate" type="application/atom+xml" title="<%= config.title %>" href="<%= config.root %>atom.xml">
    <title><%= pageTitle %></title>
    <link rel="canonical" href="<%= canonical %>">

    <meta property="og:type" content="<%= ogType %>">
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= pageDesc %>">
    <meta property="og:url" content="<%= canonical %>">
    <meta property="og:site_name" content="<%= config.title %>">
    <meta property="og:image" content="<%= heroAbs %>">
    <meta property="og:locale" content="zh_CN">
    <% if (is_post()) { %>
    <meta property="article:published_time" content="<%= page.date.toISOString() %>">
    <meta property="article:modified_time" content="<%= (page.updated || page.date).toISOString() %>">
    <meta property="article:author" content="<%= page.author || config.author %>">
    <% page.tags.forEach(function(tag) { %><meta property="article:tag" content="<%= tag.name %>">
    <% }) %><% } %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= pageTitle %>">
    <meta name="twitter:description" content="<%= pageDesc %>">
    <meta name="twitter:image" content="<%= heroAbs %>">

    <link rel="preload" as="image" href="<%= heroWebp %>" type="image/webp">
    <link rel="preload" as="image" href="<%= heroAbs %>" type="image/jpeg">

    <%- css('css/site.css') %>
    <%- css('css/beantech.min.css') %>
    <%- css('css/widget') %>
    <%- css('css/rocket') %>
    <%- css('css/signature') %>
    <% if (is_post()) { %>
    <%- css('css/highlight') %>
    <%- css('css/toc') %>
    <% } %>
    <script src="<%= config.root %>js/i18n.js" defer></script>

    <script type="application/ld+json">
    <%- JSON.stringify(is_post() ? {
      '@context': 'https://schema.org',
      '@type': page.content_type === 'historical_digest' ? 'NewsArticle' : 'BlogPosting',
      headline: page.title,
      description: pageDesc,
      image: heroAbs,
      datePublished: page.date ? page.date.toISOString() : undefined,
      dateModified: (page.updated || page.date) ? (page.updated || page.date).toISOString() : undefined,
      author: { '@type': 'Person', name: page.author || config.author },
      isBasedOn: page.content_type === 'historical_digest' ? page.source_url : undefined,
      mainEntityOfPage: canonical,
      publisher: { '@type': 'Person', name: config.author }
    } : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: config.title,
      url: config.url,
      description: config.description,
      inLanguage: 'zh-CN',
      author: { '@type': 'Person', name: config.author }
    }) %>
    </script>
</head>
