<%
  const pageLabels = {
    'about/': 'nav.about',
    'tags/': 'nav.tags',
    'archive/': 'nav.archive',
    'topics/': 'nav.topics'
  };
%>
<nav class="navbar navbar-default navbar-custom navbar-fixed-top" role="navigation">
    <div class="container-fluid">
        <div class="navbar-header page-scroll">
            <button type="button" class="navbar-toggle" aria-controls="huxblog_navbar" aria-expanded="false" aria-label="打开导航菜单" data-i18n-aria="nav.menu">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            <a class="navbar-brand" style="margin-left:0;padding:10px;" href="<%= config.root %>">
                <img src="<%= config.root %>img/y.png" alt="<%= config.title %>" height="100%">
                <span class="brand-text"><%= config.title %></span>
            </a>
        </div>

        <div id="huxblog_navbar">
            <div class="navbar-collapse">
                <ul class="nav navbar-nav navbar-right">
                    <li>
                        <a href="<%= config.root %>" data-i18n="nav.home">首页</a>
                    </li>
                    <% site.pages.forEach(function(page){ %>
                        <% const label = pageLabels[page.path.replace('index.html', '')]; %>
                        <% if(page.title && page.path !== 'search/index.html'){ %>
                        <li>
                            <a href="<%= config.root %><%= page.path.replace('index.html', '') %>"<% if (label) { %> data-i18n="<%= label %>"<% } %>><%= page.title %></a>
                        </li>
                        <% } %>
                    <% }); %>
                    <li class="locale-switcher">
                        <button type="button" class="locale-switcher__button" data-locale-switch data-i18n="locale.switch" data-i18n-aria="locale.switchAria" aria-label="切换至 English">English</button>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</nav>
<script>
    (function () {
        var $toggle = document.querySelector('.navbar-toggle');
        var $navbar = document.querySelector('#huxblog_navbar');
        var $collapse = document.querySelector('.navbar-collapse');
        if (!$toggle || !$navbar || !$collapse) return;
        $toggle.addEventListener('click', function () {
            var open = $navbar.className.indexOf('in') > -1;
            if (open) {
                $navbar.className = ' ';
                $toggle.setAttribute('aria-expanded', 'false');
                setTimeout(function () {
                    if ($navbar.className.indexOf('in') < 0) $collapse.style.height = '0px';
                }, 400);
            } else {
                $collapse.style.height = 'auto';
                $navbar.className += ' in';
                $toggle.setAttribute('aria-expanded', 'true');
            }
        });
    })();
</script>
