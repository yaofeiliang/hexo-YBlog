<! -- 添加捐赠图标 -->
<div class ="post-donate">
    <div id="donate_board" class="donate_bar center">
        <a id="btn_donate" class="btn_donate" href="javascript:;" title="打赏"></a>
        <span class="donate_txt">
            <%= theme.donate_message || config.donate_message %>
        </span>
        <br>
    </div>
    <div id="donate_guide" class="donate_bar center hidden" >
        <!-- 方式一：
            ![](/img/Alipay.jpg)
            ![](/img/WeChatpay.jpg)
        -->
        <!-- 方式二；
            step1：在_config.yml中添加配置
                Alipay: /img/Alipay.jpg
                WeChatpay: /img/WeChatpay.jpg
            step2：此处两张图片的路径分别设置为如下
                <img src="<%- config.root %><%= theme.Alipay || config.Alipay %>"
                <img src="<%- config.root %><%= theme.WeChatpay || config.WeChatpay %>"
        -->
        <!--&lt;!&ndash; 支付宝打赏图案 &ndash;&gt;-->
        <img src="<%- config.root %>img/Alipay.jpg" alt="支付宝打赏">
        <!-- &lt;!&ndash; 微信打赏图案 &ndash;&gt;-->
        <img src="<%- config.root %>img/WeChatpay.jpg" alt="微信打赏">

    </div>
    <script type="text/javascript">
      var btn=document.getElementById('btn_donate');
      var board=document.getElementById('donate_board');
      var guide=document.getElementById('donate_guide');
      if(btn&&board&&guide){
        btn.addEventListener('click',function(){
          board.classList.add('hidden');
          guide.classList.remove('hidden');
        });
      }
    </script>
</div>