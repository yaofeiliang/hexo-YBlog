<%
  function withWebp(url) {
    if (!url) return { jpg: '', webp: '' };
    const jpg = url;
    const webp = url.replace(/\.(jpg|jpeg|png)$/i, '.webp');
    return { jpg, webp };
  }
  let hero;
  if (is_home()) hero = withWebp(config['header-img']);
  else if (is_post()) hero = withWebp(page['header-img'] || config['article-img']);
  else hero = withWebp(page['header-img'] || config['archives-img'] || config['header-img']);
%>
<style type="text/css">
    header.intro-header {
        background-image: url('<%= hero.jpg %>');
        background-image: -webkit-image-set(url('<%= hero.webp %>') type('image/webp'), url('<%= hero.jpg %>') type('image/jpeg'));
        background-image: image-set(url('<%= hero.webp %>') type('image/webp'), url('<%= hero.jpg %>') type('image/jpeg'));
    }
    <% if (config.signature) { %>
    #signature {
        background-image: url('<%= config.root + config["signature-img"] %>');
    }
    <% } %>
</style>

<header class="intro-header">
    <div id="signature">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1">
                <% if (is_post()) { %>
                    <div class="post-heading">
                        <div class="tags">
                            <% page.tags.forEach(function(tag){ %>
                              <a class="tag" href="<%= config.root %>tags/#<%= tag.name %>" title="<%= tag.name %>"><%= tag.name %></a>
                            <% }) %>
                        </div>
                        <h1><%= page.title %></h1>
                        <% if (page.subtitle) { %><h2 class="subheading"><%= page.subtitle %></h2><% } %>
                        <span class="meta">
                            <%= page.author || config.author %> · <%= page.date.format(config.date_format) %>
                        </span>
                    </div>
                <% } else if (is_home()) { %>
                    <div class="site-heading">
                        <div class="brand-mark"><%= config.author %></div>
                        <h1><%= config.title %></h1>
                        <span class="subheading"><%= config.subtitle || config.description || "" %></span>
                    </div>
                <% } else { %>
                    <div class="site-heading">
                        <div class="brand-mark"><%= config.title %></div>
                        <h1><%= page.title || config.title %></h1>
                        <span class="subheading"><%= page.description || "" %></span>
                    </div>
                <% } %>
                </div>
            </div>
        </div>
    </div>
</header>
