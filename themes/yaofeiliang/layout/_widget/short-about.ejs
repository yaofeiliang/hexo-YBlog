<!-- Short About -->
<section class="visible-md visible-lg">
    <h5><a href="<%= config.root %>about/">ABOUT ME</a></h5>
    <div class="short-about">

        <% if(config['sidebar-avatar']) { %>
            <img id = "avatar_pic" src="<%= config['sidebar-avatar'] %>" />
        <% } %>

        <% if(config['sidebar-about-description']) { %>
            <p><%= config['sidebar-about-description'] %></p>
        <% }%>

        <!-- SNS Link -->
        <ul class="list-inline">
            <% if (config.RSS !== false) { %>
                <li>
                    <a href="<%= config.root %>atom.xml" rel="noopener">
                        <span class="fa-stack fa-lg">
                            <i class="fa fa-circle fa-stack-2x"></i>
                            <i class="fa fa-rss fa-stack-1x fa-inverse"></i>
                        </span>
                    </a>
                </li>
            <% } %>
            <% if (config.zhihu_username) { %>
                <li>
                    <a target="_blank" rel="noopener noreferrer" href="https://www.zhihu.com/people/<%= config.zhihu_username %>">
                        <span class="fa-stack fa-lg">
                            <i class="fa fa-circle fa-stack-2x"></i>
                            <i class="fa fa-stack-1x fa-inverse">知</i>
                        </span>
                    </a>
                </li>
            <% } %>
            <% if (config.weibo_username) { %>
                <li>
                    <a target="_blank" rel="noopener noreferrer" href="https://weibo.com/<%= config.weibo_username %>">
                        <span class="fa-stack fa-lg">
                            <i class="fa fa-circle fa-stack-2x"></i>
                            <i class="fa fa-weibo fa-stack-1x fa-inverse"></i>
                        </span>
                    </a>
                </li>
            <% } %>
            <% if (config.github_username) { %>
                <li>
                    <a target="_blank" rel="noopener noreferrer" href="https://github.com/<%= config.github_username %>">
                        <span class="fa-stack fa-lg">
                            <i class="fa fa-circle fa-stack-2x"></i>
                            <i class="fa fa-github fa-stack-1x fa-inverse"></i>
                        </span>
                    </a>
                </li>
            <% } %>
            <% if (config.linkedin_username) { %>
                <li>
                    <a target="_blank" rel="noopener noreferrer" href="https://www.linkedin.com/in/<%= config.linkedin_username %>">
                        <span class="fa-stack fa-lg">
                            <i class="fa fa-circle fa-stack-2x"></i>
                            <i class="fa fa-linkedin fa-stack-1x fa-inverse"></i>
                        </span>
                    </a>
                </li>
            <% } %>
        </ul>
    </div>
</section>
