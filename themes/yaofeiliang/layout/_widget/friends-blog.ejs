<!-- Friends Blog -->
<% if(config.friends) { %>
<h5 data-i18n="widget.friends">友情链接</h5>
<ul class="list-inline">
    <% config.friends.forEach(function(friend){ %>
        <li><a href="<%= friend.href %>" target="_blank" rel="noopener noreferrer"><%= friend.title %></a></li>
    <% }); %>
</ul>
<% }%>
