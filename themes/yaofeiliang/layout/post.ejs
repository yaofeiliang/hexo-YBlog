---
layout: layout
---

<article data-pagefind-body>
    <div class="container">
        <div class="row">
            <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1 post-container">
                <p class="content-language-note" data-i18n="content.originalLanguage">本文原始语言为中文。</p>
                <%- partial('_partial/knowledge-meta') %>
                <%- page.content %>
                <% if (config.donate !== false) { %>
                <%- partial('_partial/donate') %>
                <% } %>
                <hr>
                <ul class="pager">
                    <% if (page.prev){ %>
                        <li class="previous">
                            <a href="<%- config.root %><%- page.prev.path %>" title="<%- page.prev.title %>" data-i18n="post.previous">← 上一篇</a>
                        </li>
                    <% } %>
                    <% if (page.next){ %>
                        <li class="next">
                            <a href="<%- config.root %><%- page.next.path %>" title="<%- page.next.title %>" data-i18n="post.next">下一篇 →</a>
                        </li>
                    <% } %>
                </ul>

                <%- partial('_partial/community') %>
                <%- partial('_partial/comments') %>
            </div>

            <%- partial('_partial/toc') %>

            <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1 sidebar-container">
                <% if(config['featured-tags'] && page.tags && page.tags.length) { %>
                <section>
                    <h5><a href="<%= config.root %>tags/" data-i18n="widget.featuredTags">精选标签</a></h5>
                    <div class="tags">
                       <% page.tags.forEach(function(tag){ %>
                          <a class="tag" href="<%= config.root %>tags/#<%= tag.name %>" title="<%= tag.name %>"><%= tag.name %></a>
                        <% }) %>
                    </div>
                </section>
                <% }%>

                <% if(config.friends) { %>
                <hr>
                <h5 data-i18n="widget.friends">友情链接</h5>
                <ul class="list-inline">
                    <% config.friends.forEach(function(friend){ %>
                        <li><a href="<%= friend.href %>" target="_blank" rel="noopener noreferrer"><%= friend.title %></a></li>
                    <% }); %>
                </ul>
                <% }%>
            </div>
        </div>
    </div>
</article>

<% if(config['anchorjs']) { %>
<script>
    (function () {
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/anchor-js@4.3.1/anchor.min.js';
      s.async = true;
      s.onload = function () {
        anchors.options = { visible: 'hover', placement: 'left', icon: 'ℬ' };
        anchors.add().remove('.intro-header h1').remove('.subheading').remove('.sidebar-container h5');
      };
      document.body.appendChild(s);
    })();
</script>
<style>
    @media all and (min-width: 800px) {
        .anchorjs-link{ position:absolute; left:-0.75em; font-size:1.1em; margin-top:-0.1em; }
    }
</style>
<% } %>
